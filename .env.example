
# Bluesky
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=your-generated-app-password

# Mastodon
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token

# WordPress
WORDPRESS_CLIENT_ID=your_wordpress_client_id
WORDPRESS_CLIENT_SECRET=your_wordpress_client_secret
WORDPRESS_ACCESS_TOKEN=your_wordpress_access_token
WORDPRESS_SITE_URL=https://your-site.wordpress.com

# Tumblr
TUMBLR_CLIENT_ID=your_tumblr_client_id
TUMBLR_CLIENT_SECRET=your_tumblr_client_secret
TUMBLR_ACCESS_TOKEN=your_tumblr_access_token
TUMBLR_REFRESH_TOKEN=your_tumblr_refresh_token
TUMBLR_BLOG_IDENTIFIER=your_blog_identifier

# DEV.to
DEVTO_API_KEY=your_devto_api_key
